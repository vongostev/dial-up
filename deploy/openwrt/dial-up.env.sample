# dial-up environment variables
# Copy this file to /etc/dial-up.env and fill in your values.

VK_TOKEN=your_vk_user_token_here (it is very long)
OLCRTC_KEY=your_openssl_rand_hex_32_here

# Set to false for server mode
IS_CLIENT=true

# Set to true for debug logging
DEBUG=false

# Path to the olcrtc binary
OLCRTC_EXE=/etc/olcrtc-linux-arm64

# Data directory
DATA_DIR=data

# Last provider persistence file
LAST_PROVIDER_FILE=last_provider.json

# Comma-separated VK user IDs (empty = allow all)
ALLOWED_USER_IDS=

# Seconds to sleep after error recovery
SLEEP_ON_ERROR=5

# Local HTTP status endpoint port for the LuCI panel (loopback only, 127.0.0.1)
# Default 9091 (9090 is reserved for the sing-box Clash API).
STATUS_PORT=9091

# ── Server-only: upstream SOCKS5 egress (ignored in client mode) ──
# Empty SOCKS_PROXY_ADDR = direct egress (no upstream proxy).
# Empty SOCKS_PROXY_USER = no-auth SOCKS5 (RFC 1929 method 0x00).
# SOCKS_PROXY_ADDR=
# SOCKS_PROXY_PORT=
# SOCKS_PROXY_USER=
# SOCKS_PROXY_PASS=

# ── Server-only: egress DNS resolver (ignored in client mode) ──
# DNS the server olcrtc process uses for its own resolution.
# Default 127.0.0.1:53 routes through the local podkop/sing-box resolver.
NET_DNS=127.0.0.1:53

# ── Client-only: AmneziaWG (awg) fallback routing ──
# AWG_IFACE: interface to use for the "awg" route. Empty = auto-detect the single
# amneziawg interface; with several interfaces set it explicitly (e.g. awg1).
AWG_IFACE=
# Max age (seconds) of the latest AWG handshake for "online".
AWG_HANDSHAKE_MAX=180
# Standing route when direct internet is available: "awg" or "direct".
# awg falls back to direct when the interface is offline.
DEFAULT_MODE=direct
# Probe target for direct-internet presence; 2xx/3xx means direct access works,
# so olcrtc is halted to save mobile traffic. Empty disables the probe.
PROBE_URL=https://www.google.com/generate_204
