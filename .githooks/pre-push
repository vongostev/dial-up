#!/bin/sh
# pre-push guard: запрещает push, публикующий приватные данные.
# Паттерны читаются из .scrub-rules.txt (локальный файл, в .gitignore).
# Срабатывает на КАЖДЫЙ push в любой remote; если файла нет — пропускает.
set -u

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$ROOT" ] || exit 0
RULES="$ROOT/.scrub-rules.txt"
[ -f "$RULES" ] || exit 0

PATTERNS=""
while IFS= read -r line; do
  case "$line" in ''|'#'*) continue ;; esac
  pat=${line%%==>*}
  PATTERNS="$PATTERNS $pat"
done < "$RULES"
[ -n "$PATTERNS" ] || exit 0

while read -r local_ref local_oid remote_ref remote_oid; do
  [ -n "$local_ref" ] || continue
  [ "$local_oid" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_oid" = "0000000000000000000000000000000000000000" ]; then
    range="$local_oid"
  else
    range="$remote_oid..$local_oid"
  fi
  for pat in $PATTERNS; do
    if git log --format="%H" --fixed-strings --grep="$pat" "$range" 2>/dev/null | grep -q .; then
      echo "PRE-PUSH BLOCKED: push $local_ref опубликует '$pat' в сообщении коммита" >&2
      echo "  Исправление: sh scripts/scrub-history.sh, затем push из mirror" >&2
      exit 1
    fi
    if git log -p "$range" 2>/dev/null | grep -qF "$pat"; then
      echo "PRE-PUSH BLOCKED: push $local_ref опубликует '$pat' в содержимом файлов" >&2
      echo "  Исправление: sh scripts/scrub-history.sh, затем push из mirror" >&2
      exit 1
    fi
  done
done
exit 0
